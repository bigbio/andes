{
  "id": "peak-gbdt-fixture",
  "description": "3-feature multi-tree AGBD\u2192ONNX (andes peak-GBDT shape)",
  "onnx": "peak_gbdt.onnx",
  "inputs": [
    {
      "name": "features",
      "shape": [
        null,
        3
      ]
    }
  ],
  "outputs": [
    {
      "name": "score",
      "shape": [
        null,
        1
      ]
    }
  ],
  "task": "tree_ensemble",
  "provenance": {
    "origin": "onnx-infer fixture (andes AGBD layout)",
    "license": "Apache-2.0"
  },
  "extras": {
    "n_features": 3,
    "n_trees": 3,
    "agbd": "peak_gbdt.agbd",
    "output": "raw_tree_sum",
    "apply_sigmoid": true,
    "iso_x": [
      0.0,
      0.5,
      1.0
    ],
    "iso_y": [
      0.05,
      0.4,
      0.95
    ],
    "consumer": "quantms-rescoring"
  }
}
